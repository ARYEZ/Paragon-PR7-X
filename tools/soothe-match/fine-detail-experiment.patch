+TEST_CASE ("DOMINION REFINED with LOOK-AHEAD hears single harmonics: it cuts them more than the gaps between them", "[dominion][refined]")
+{
+    // A chord-like sound: pink noise and the harmonics of 196 Hz from 2 to 5 kHz,
+    // each 12 dB over the noise around it. soothe 3 cuts a guitar chord's single
+    // harmonics (its cut ripples with them); a bank of 1/6-octave filters can't
+    // tell them apart (at 3 kHz they're 1/16 octave apart), the fine detail can.
+    const auto play = [] (bool lookahead, double hz)
+    {
+        Pink pink (5);
+        std::vector<float> in;
+        const auto source = [&] (int n)
+        {
+            while ((int) in.size() <= n)
+            {
+                const auto i = (int) in.size();
+                double x = pink();
+                for (int h = 11; h <= 25; ++h)
+                    x += 0.004 * std::sin (2.0 * pi * 196.0 * h * i / sampleRate + h);
+                in.push_back ((float) x);
+            }
+            return in[(size_t) n];
+        };
+        DominionRig rig;
+        rig.settings = refined();
+        rig.settings.lookahead = lookahead;
+        rig.settings.depth = 7.5;
+        rig.settings.on = true;
+        const auto out = rig.play (6.0, source, source);
+        const auto late = (size_t) rig.processor.getLatencySamples (rig.settings);
+        std::vector<float> aligned (out[0].begin() + (long) late, out[0].end());
+        std::vector<float> input (in.begin(), in.begin() + (long) aligned.size());
+        return toneDb (aligned, hz) - toneDb (input, hz);
+    };
+    for (const auto lookahead : { true, false })
+    {
+        double onHarmonics = 0.0, between = 0.0;
+        for (int h = 14; h <= 18; ++h)
+        {
+            onHarmonics += play (lookahead, 196.0 * h) / 5.0;
+            between += play (lookahead, 196.0 * (h + 0.5)) / 5.0;
+        }
+        WARN ((lookahead ? "Fine detail" : "Filter bank") << ": on the harmonics " << onHarmonics << " dB, between them " << between << " dB");
+        if (lookahead)
+            CHECK (onHarmonics < between - 1.0);
+        else
+            CHECK (std::abs (onHarmonics - between) < 1.0);
+    }
+}
+
