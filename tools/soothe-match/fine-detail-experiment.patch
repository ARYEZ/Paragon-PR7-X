+    //==========================================================================
+    // REFINED with LOOK-AHEAD, in fine detail (0.26.0). soothe 3 cuts single
+    // harmonics of a guitar chord (its cut ripples with them); a bank of
+    // 1/6-octave filters can't hear them apart, so here the sound goes through
+    // an FFT (2048 points at 44.1/48 kHz: a bin every 21.5 Hz), each bin is
+    // judged against the bins around it, and the cut is made on the spectrum,
+    // all inside the delay REFINED already has. Our own design.
+    void Processor::prepareFine()
+    {
+        const auto base = fineTuning().frameSize < 1536.0 ? 10 : 11;   // 1024 or 2048 points at 44.1/48 kHz
+        fftOrder = base + (latency <= 2304 ? 0 : latency <= 4704 ? 1 : 2);
+        fftSize = 1 << fftOrder;
+        hop = fftSize / 8;
+        numBins = fftSize / 2 + 1;
+        fft = std::make_unique<juce::dsp::FFT> (fftOrder);
+        fftWindow.resize ((size_t) fftSize);
+        for (int n = 0; n < fftSize; ++n)   // sqrt of a periodic Hann: in and out, 8 to a frame, they add up to 4
+            fftWindow[(size_t) n] = (float) std::sqrt (0.5 - 0.5 * std::cos (2.0 * pi * n / fftSize));
+        fftWork.assign ((size_t) (2 * fftSize), 0.0f);
+        for (int c = 0; c < 2; ++c)
+        {
+            fftIn[(size_t) c].assign ((size_t) fftSize, 0.0f);
+            fftOut[(size_t) c].assign ((size_t) (2 * (latency + fftSize)), 0.0f);
+            spectrum[(size_t) c].assign ((size_t) (2 * fftSize), 0.0f);
+            for (auto* v : { &binCurve[(size_t) c], &binLevel[(size_t) c], &binCut[(size_t) c], &binTarget[(size_t) c] })
+                v->assign ((size_t) numBins, 0.0);
+        }
+        for (auto* v : { &binHz, &binWeight, &binMargin, &binScale, &binAttack, &binRelease, &binSpread, &scratch })
+            v->assign ((size_t) numBins, 0.0);
+        prefix.assign ((size_t) numBins + 1, 0.0);
+        bandPrefix.assign ((size_t) numBins + 1, 0.0);
+        binQuiet.assign ((size_t) numBins, 1.0);
+        for (auto* v : { &binFrom, &binTo, &binNearFrom, &binNearTo, &binBandFrom, &binBandTo })
+            v->assign ((size_t) numBins, 0);
+        for (int k = 0; k < numBins; ++k)
+            binHz[(size_t) k] = k * sampleRate / fftSize;
+        resetFine();
+    }
+
+    void Processor::resetFine() noexcept
+    {
+        for (int c = 0; c < 2; ++c)
+        {
+            std::fill (fftIn[(size_t) c].begin(), fftIn[(size_t) c].end(), 0.0f);
+            std::fill (fftOut[(size_t) c].begin(), fftOut[(size_t) c].end(), 0.0f);
+            std::fill (binLevel[(size_t) c].begin(), binLevel[(size_t) c].end(), 0.0);
+            std::fill (binCut[(size_t) c].begin(), binCut[(size_t) c].end(), 0.0);
+        }
+        inAt = sinceHop = 0;
+        outAt = 0;
+    }
+
+    void Processor::updateFineShape (const Settings& s)
+    {
+        const auto& t = fineTuning();
+        const auto seconds = (double) hop / sampleRate;
+        const auto ln2 = std::log (2.0);
+        for (int k = 1; k < numBins; ++k)
+        {
+            const auto hz = binHz[(size_t) k];
+            const auto low = lowWeight (hz), high = highWeight (hz);
+            const auto detail = juce::jlimit (0.0, 100.0, s.detail + 0.5 * (s.detailTiltLow * low + s.detailTiltHigh * high));
+            binMargin[(size_t) k] = juce::jmap (detail / 100.0, t.margin0, t.margin100);
+            binScale[(size_t) k] = between3 (detail, t.detailScale0, 1.0, t.detailScale100);
+            const auto at = juce::jlimit (0.0, (double) t.weight.size() - 1.0, std::log2 (std::max (hz, 1.0) / 25.0));
+            const auto i = std::min ((int) at, (int) t.weight.size() - 2);
+            binWeight[(size_t) k] = std::max (0.0, t.weight[(size_t) i] + (t.weight[(size_t) i + 1] - t.weight[(size_t) i]) * (at - i));
+
+            // SOFT's neighbourhood (octaves either side, by DETAIL), less the nearest bins; HARD's 1/6 octave.
+            const auto window = juce::jmap (detail / 100.0, t.window0, t.window100);
+            const auto from = std::max (1, (int) std::floor (k * std::pow (2.0, -window)));
+            const auto to = std::min (numBins - 1, (int) std::ceil (k * std::pow (2.0, window)));
+            binFrom[(size_t) k] = from;
+            binTo[(size_t) k] = to;
+            binNearFrom[(size_t) k] = juce::jlimit (from, k, std::min (k - 1, (int) std::floor (k * std::pow (2.0, -t.nearOct))));
+            binNearTo[(size_t) k] = juce::jlimit (k, to, std::max (k + 1, (int) std::ceil (k * std::pow (2.0, t.nearOct))));
+            binBandFrom[(size_t) k] = std::max (1, std::min (k, (int) std::floor (k * std::pow (2.0, -1.0 / 12.0))));
+            binBandTo[(size_t) k] = std::min (numBins - 1, std::max (k, (int) std::ceil (k * std::pow (2.0, 1.0 / 12.0))));
+
+            // How far a cut spreads across frequencies: an exponential either side, `width` octaves to 1/e.
+            const auto spreadBins = between3 (detail, t.width0, t.width50, t.width100) * k * ln2;
+            binSpread[(size_t) k] = std::exp (-1.0 / std::max (spreadBins, 1.0e-3));
+
+            const auto hard = s.mode == Mode::hard;
+            const auto byFrequency = std::pow (1000.0 / std::max (hz, 10.0), t.timingPower);
+            const auto attackTilt = std::pow (4.0, (s.attackTiltLow * low + s.attackTiltHigh * high) / 100.0);
+            const auto releaseTilt = std::pow (4.0, (s.releaseTiltLow * low + s.releaseTiltHigh * high) / 100.0);
+            const auto attack = juce::jlimit (0.0002, 2.0, 0.001 * between4 (s.attack, t.attack0, t.attack25, t.attack50, t.attack100)
+                                                          * between3 (detail, t.detailAttack0, 1.0, t.detailAttack100) * byFrequency * attackTilt
+                                                          * (hard ? t.hardAttack : 1.0));
+            const auto release = juce::jlimit (0.002, 6.0, 0.001 * between3 (s.release, t.release0, t.release50, t.release100)
+                                                           * between3 (detail, t.detailRelease0, 1.0, t.detailRelease100) * byFrequency * releaseTilt
+                                                           * (hard ? t.hardRelease : 1.0));
+            binAttack[(size_t) k] = 1.0 - std::exp (-seconds / attack);
+            binRelease[(size_t) k] = 1.0 - std::exp (-seconds / release);
+        }
+    }
+
+    void Processor::updateFineCurve()
+    {
+        // The depth curve at each bin, between the filters' (an octave is 12 of them).
+        for (int c = 0; c < 2; ++c)
+            for (int k = 0; k < numBins; ++k)
+            {
+                const auto at = juce::jlimit (0.0, (double) numFilters - 1.0, std::log2 (std::max (binHz[(size_t) k], 20.0) / 20.0) / spacingOctaves);
+                const auto i = std::min ((int) at, numFilters - 2);
+                const auto& f = curve[(size_t) c];
+                binCurve[(size_t) c][(size_t) k] = f[(size_t) i] + (f[(size_t) i + 1] - f[(size_t) i]) * (at - i);
+            }
+    }
+
+    void Processor::fineProcess (const juce::AudioBuffer<float>& in, juce::dsp::AudioBlock<float> out, const Settings& s) noexcept
+    {
+        const auto numChannels = (int) juce::jmin ((size_t) 2, out.getNumChannels());
+        const auto numSamples = (int) out.getNumSamples();
+        const auto midSide = s.stereo == StereoMode::midSide && numChannels == 2;
+        const auto size = (long long) fftOut[0].size();
+        for (int i = 0; i < numSamples; ++i)
+        {
+            const auto l = in.getSample (0, i);
+            const auto r = numChannels > 1 ? in.getSample (1, i) : l;
+            fftIn[0][(size_t) inAt] = midSide ? 0.5f * (l + r) : l;
+            fftIn[1][(size_t) inAt] = midSide ? 0.5f * (l - r) : r;
+            inAt = (inAt + 1) % fftSize;
+            if (++sinceHop == hop)
+            {
+                sinceHop = 0;
+                fineFrame (s, numChannels);
+            }
+            // Out: the sound `latency` samples ago, every frame over it now added in.
+            const auto at = (size_t) (((outAt - latency) % size + size) % size);
+            const auto a = fftOut[0][at], b = fftOut[1][at];
+            fftOut[0][at] = fftOut[1][at] = 0.0f;
+            out.setSample (0, i, midSide ? a + b : a);
+            if (numChannels > 1)
+                out.setSample (1, i, midSide ? a - b : b);
+            ++outAt;
+        }
+    }
+
+    void Processor::fineFrame (const Settings& s, int numChannels) noexcept
+    {
+        const auto& t = fineTuning();
+        const auto bins = (size_t) numBins;
+        // Each channel's spectrum, and each bin's power, smoothed.
+        const auto smoothing = 1.0 - std::exp (-(double) hop / (sampleRate * std::max (1.0e-4, t.levelMs * 0.001)));
+        for (int c = 0; c < numChannels; ++c)
+        {
+            for (int n = 0; n < fftSize; ++n)
+                fftWork[(size_t) n] = fftIn[(size_t) c][(size_t) ((inAt + n) % fftSize)] * fftWindow[(size_t) n];
+            std::fill (fftWork.begin() + fftSize, fftWork.end(), 0.0f);
+            fft->performRealOnlyForwardTransform (fftWork.data(), true);
+            std::copy (fftWork.begin(), fftWork.end(), spectrum[(size_t) c].begin());
+            auto& level = binLevel[(size_t) c];
+            for (size_t k = 0; k < bins; ++k)
+            {
+                const auto re = (double) fftWork[2 * k], im = (double) fftWork[2 * k + 1];
+                level[k] += smoothing * (re * re + im * im - level[k]);
+            }
+        }
+
+        // In dB, with LINK part of the way to both channels together.
+        auto loudest = -400.0;
+        for (size_t k = 1; k < bins; ++k)
+        {
+            const auto both = 10.0 * std::log10 (binLevel[0][k] + (numChannels > 1 ? binLevel[1][k] : binLevel[0][k]) + 1.0e-30);
+            for (int c = 0; c < numChannels; ++c)
+            {
+                const auto own = 10.0 * std::log10 (2.0 * binLevel[(size_t) c][k] + 1.0e-30);
+                const auto linked = numChannels > 1 ? own + (both - own) * s.link / 100.0 : own;
+                binTarget[(size_t) c][k] = linked;   // the level for now; the target below
+                loudest = std::max (loudest, linked);
+            }
+        }
+
+        const auto depth = juce::jlimit (0.0, 20.0, s.depth);
+        const auto scale = t.depthScale * std::pow (std::max (0.0, depth - t.depthStart) / (5.0 - t.depthStart), t.depthPower);
+        const auto margin = t.marginDepth * (depth - 5.0);
+        const auto hardLevel = t.hard5 - t.hardStep * (depth - 5.0) - t.hardCurve * (depth - 5.0) * std::abs (depth - 5.0);
+        const auto maxCut = juce::jlimit (0.0, maxReductionDb, s.maxCutDb);
+        const auto inverseScale = 0.25f;   // the windows' overlap (JUCE's inverse FFT is already scaled)
+        const auto size = (long long) fftOut[0].size();
+        const auto smoothBins = juce::jlimit (0, 8, juce::roundToInt (t.binSmooth));
+        for (int c = 0; c < numChannels; ++c)
+        {
+            auto& e = binTarget[(size_t) c];
+            if (s.mode == Mode::soft && t.quietStart < 150.0)
+            {
+                // How far each 1/6 octave is under the loudest one (as power per octave), and so how much SOFT may cut there.
+                bandPrefix[0] = 0.0;
+                for (size_t k = 0; k < bins; ++k)
+                    bandPrefix[k + 1] = bandPrefix[k] + (k == 0 ? 0.0 : std::pow (10.0, e[k] / 10.0));
+                auto loudestBand = -400.0;
+                for (size_t k = 1; k < bins; ++k)
+                {
+                    binQuiet[k] = 10.0 * std::log10 (bandPrefix[(size_t) binBandTo[k] + 1] - bandPrefix[(size_t) binBandFrom[k]] + 1.0e-30);
+                    if (binHz[k] >= 50.0 && binHz[k] <= 16000.0)
+                        loudestBand = std::max (loudestBand, binQuiet[k]);
+                }
+                for (size_t k = 1; k < bins; ++k)
+                    binQuiet[k] = juce::jlimit (0.0, 1.0, 1.0 + std::min (0.0, binQuiet[k] - loudestBand + t.quietStart) / std::max (1.0, t.quietRange));
+            }
+            else
+            {
+                std::fill (binQuiet.begin(), binQuiet.end(), 1.0);
+            }
+            if (smoothBins > 0 && s.mode == Mode::soft)
+            {
+                // Each bin's level (as power) averaged with its neighbours, back in dB.
+                prefix[0] = 0.0;
+                for (size_t k = 0; k < bins; ++k)
+                    prefix[k + 1] = prefix[k] + (k == 0 ? 0.0 : std::pow (10.0, e[k] / 10.0));
+                for (size_t k = 1; k < bins; ++k)
+                {
+                    const auto from = std::max ((size_t) 1, k - (size_t) std::min ((int) k - 1, smoothBins)), to = std::min (bins - 1, k + (size_t) smoothBins);
+                    scratch[k] = 10.0 * std::log10 ((prefix[to + 1] - prefix[from]) / (double) (to - from + 1) + 1.0e-30);
+                }
+                for (size_t k = 1; k < bins; ++k)
+                    e[k] = scratch[k];
+            }
+            // Running sums: of the levels in dB (SOFT), or of the powers (HARD).
+            prefix[0] = 0.0;
+            for (size_t k = 0; k < bins; ++k)
+                prefix[k + 1] = prefix[k] + (k == 0 ? 0.0 : s.mode == Mode::soft ? e[k] : std::pow (10.0, e[k] / 10.0));
+            for (size_t k = 1; k < bins; ++k)
+            {
+                double target = 0.0;
+                if (binHz[k] >= 20.0 && e[k] > loudest - floorBelowLoudestDb)
+                {
+                    if (s.mode == Mode::soft)
+                    {
+                        const auto from = (size_t) binFrom[k], to = (size_t) binTo[k], nearFrom = (size_t) binNearFrom[k], nearTo = (size_t) binNearTo[k];
+                        const auto count = (double) ((to - from + 1) - (nearTo - nearFrom + 1));
+                        const auto around = count > 0 ? ((prefix[to + 1] - prefix[from]) - (prefix[nearTo + 1] - prefix[nearFrom])) / count : e[k];
+                        target = scale * binScale[k] * binWeight[k] * binQuiet[k] * std::pow (kneeOver (e[k] - around - binMargin[k] + margin, t.knee), t.overPower);
+                    }
+                    else
+                    {
+                        const auto band = 10.0 * std::log10 (prefix[(size_t) binBandTo[k] + 1] - prefix[(size_t) binBandFrom[k]] + 1.0e-30);
+                        const auto tilted = band + t.hardTilt * std::log2 (binHz[k] / 1000.0);
+                        target = t.hardSlope * (t.hardFlat + (1.0 - t.hardFlat) * binWeight[k]) * kneeOver (tilted - hardLevel, t.hardKnee);
+                    }
+                }
+                scratch[k] = std::min (target * binCurve[(size_t) c][k], maxCut);
+            }
+            scratch[0] = 0.0;
+
+            // Spread across frequencies (an exponential either side), then smoothed in time.
+            for (size_t k = 1; k < bins; ++k)
+                scratch[k] += binSpread[k] * (scratch[k - 1] - scratch[k]);
+            for (size_t k = bins - 1; k-- > 1;)
+                scratch[k] += binSpread[k] * (scratch[k + 1] - scratch[k]);
+            auto& cut = binCut[(size_t) c];
+            for (size_t k = 1; k < bins; ++k)
+                cut[k] += (scratch[k] - cut[k]) * (scratch[k] > cut[k] ? binAttack[k] : binRelease[k]);
+
+            // The cut on the spectrum, back to sound, overlapped and added in.
+            auto* x = spectrum[(size_t) c].data();
+            for (size_t k = 0; k < bins; ++k)
+            {
+                const auto g = (float) std::exp (-cut[k] * (std::log (10.0) / 20.0));
+                x[2 * k] *= g;
+                x[2 * k + 1] *= g;
+            }
+            std::copy (spectrum[(size_t) c].begin(), spectrum[(size_t) c].end(), fftWork.begin());
+            fft->performRealOnlyInverseTransform (fftWork.data());
+            auto& o = fftOut[(size_t) c];
+            const auto start = outAt - fftSize + 1;   // this frame's first sample's time
+            for (int n = 0; n < fftSize; ++n)
+                o[(size_t) (((start + n) % size + size) % size)] += fftWork[(size_t) n] * fftWindow[(size_t) n] * inverseScale;
+        }
+    }
+
+    double Processor::fineCutNear (int channel, double hz) const noexcept
+    {
+        // The deepest cut within a 1/24 octave of `hz`, for the display.
+        const auto binWidth = sampleRate / fftSize;
+        const auto from = std::max (1, (int) std::floor (hz * std::pow (2.0, -1.0 / 48.0) / binWidth));
+        const auto to = std::min (numBins - 1, std::max (from, (int) std::ceil (hz * std::pow (2.0, 1.0 / 48.0) / binWidth)));
+        double most = 0.0;
+        for (int k = from; k <= to; ++k)
+            most = std::max (most, binCut[(size_t) channel][(size_t) k]);
+        return most;
+    }
 }
